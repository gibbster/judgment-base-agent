[Unit]
Description=vLLM engine for DiffusionGemma (vLLM PR #57250 fork)
Documentation=https://github.com/vllm-project/vllm/pull/57250
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HF_HOME=/opt/hf
# Weights are already on the boot disk (~17 GB); this does not re-download.
ExecStart=/opt/venv/vllm/bin/vllm serve RedHatAI/diffusiongemma-26B-A4B-it-NVFP4 \
  --host 127.0.0.1 \
  --port 8000 \
  --diffusion-config '{"canvas_length": 64}' \
  --max-logprobs 32 \
  --enable-prefix-caching \
  --max-model-len 16384 \
  --gpu-memory-utilization 0.90 \
  --attention-backend TRITON_ATTN
# Cold start is ~300 s: CUDA graph capture plus weight load into the L4.
TimeoutStartSec=900
Restart=on-failure
RestartSec=15
StandardOutput=append:/var/log/djev-vllm.log
StandardError=append:/var/log/djev-vllm.log

[Install]
WantedBy=multi-user.target
