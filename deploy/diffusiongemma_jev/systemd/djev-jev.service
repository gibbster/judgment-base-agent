[Unit]
Description=Jev System One structured server (DiffusionGemma canvas reads)
Documentation=https://github.com/vllm-project/vllm/pull/57250
After=djev-vllm.service
Requires=djev-vllm.service

[Service]
Type=simple
User=root
Environment=HF_HOME=/opt/hf
# systemd starts us as soon as the vLLM unit is *launched*, not when it is
# *ready*. The engine needs ~300 s to load weights, so block until it answers.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 240); do curl -sf http://127.0.0.1:8000/v1/models >/dev/null && exit 0; sleep 5; done; echo "upstream vLLM never became ready"; exit 1'
ExecStart=/opt/venv/vllm/bin/python \
  /opt/vllm-pr/examples/features/diffusion_reads/structured_server.py \
  --upstream http://127.0.0.1:8000 \
  --model RedHatAI/diffusiongemma-26B-A4B-it-NVFP4 \
  --tokenizer RedHatAI/diffusiongemma-26B-A4B-it-NVFP4 \
  --canvas 64 \
  --host 127.0.0.1 \
  --port 8011
TimeoutStartSec=1500
Restart=always
RestartSec=10
StandardOutput=append:/var/log/djev-jev.log
StandardError=append:/var/log/djev-jev.log

[Install]
WantedBy=multi-user.target
