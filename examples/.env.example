# Copy this file to examples/.env and fill in the blanks:
#
#   cp examples/.env.example examples/.env
#
# examples/.env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# 1. Judgment backend (required)
#
# Pick ONE of the two options below. Option A is the default and needs no
# infrastructure. Option B runs the same agents against a self-hosted
# DiffusionGemma-26B on a GPU; see TESTING.md.
# ---------------------------------------------------------------------------

# --- Option A: managed TypeSafe System One API (default) -------------------
TYPESAFE_API_KEY=your_typesafe_api_key_here
JUDGMENT_MODEL=judgment-latest

# --- Option B: self-hosted DiffusionGemma-26B on a GPU ---------------------
# Uncomment all three to route every JudgmentAgent, JudgmentSwitch,
# JudgmentGuard, JudgmentMap, and JudgmentRubricEvaluator call to your own
# endpoint. TypeSafeBackend auto-delegates as soon as DIFFUSIONGEMMA_JEV_URL
# is set, so no example app code changes. Comment them out to go back to
# Option A.
#
# Start the tunnel first:  ./scripts/connect_gpu.sh
#
# DIFFUSIONGEMMA_JEV_URL=http://127.0.0.1:8011
# DIFFUSIONGEMMA_SYSTEM_ONE_PATH=/v1/systemone
# DIFFUSIONGEMMA_MODEL_ID=RedHatAI/diffusiongemma-26B-A4B-it-NVFP4
#
# Only needed if the endpoint is a private Cloud Run service rather than a
# tunnel. A user-account token carries the wrong `aud` and will 401 -- mint it
# by impersonating a service account granted roles/run.invoker.
# DIFFUSIONGEMMA_API_KEY=
#
# Send positional q0..qN question keys on the wire instead of schema key
# names. Defaults to true, which works around an upstream bug in the vLLM PR's
# structured_server.py that 422s on keys like `item_0__urgency_score`.
# Set false only if you want the key text to reach the prompt.
# DIFFUSIONGEMMA_ALIAS_QUESTION_KEYS=true

# ---------------------------------------------------------------------------
# 2. Gemini model used by the LLM half of the example agents (required)
#
# Authenticate locally with: gcloud auth application-default login
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
