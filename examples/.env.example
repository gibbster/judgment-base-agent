# 1. TypeSafe API Key (Required for JudgmentAgent / JudgmentSwitch / JudgmentGuard / JudgmentMap)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# 2. Google Cloud Application Default Credentials (ADC) via Vertex AI (Recommended)
# Run `gcloud auth application-default login` to authenticate locally with ADC
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
